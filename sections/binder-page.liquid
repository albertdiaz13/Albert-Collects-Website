{%- liquid
  assign col = section.settings.collection
  assign shown = 0
-%}
<section class="b-section b-binderpage-section" aria-labelledby="PageHeading-{{ section.id }}">
  <div class="b-wrap b-binderpage">
    <div class="b-binderpage__head">
      <h2 class="b-h2" id="PageHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="b-binderpage__text">{{ section.settings.text | escape }}</p>{%- endif -%}
      {%- if col != blank -%}
        <a class="b-btn b-btn--outline" href="{{ col.url }}">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>
    <div class="b-sheet-page">
      <span class="b-sheet-page__rings" aria-hidden="true"><i></i><i></i><i></i></span>
      <ul class="b-sheet-page__grid" role="list">
        {%- if col != blank -%}
          {%- for product in col.products limit: 40 -%}
            {%- if section.settings.available_only and product.available == false -%}{%- continue -%}{%- endif -%}
            {%- assign shown = shown | plus: 1 -%}
            {%- capture facts -%}{%- render 'binder-facts', product: product -%}{%- endcapture -%}
            {%- assign f = facts | split: '§' -%}
            <li class="b-sheet-page__slot">
              <a class="b-sheet-page__pocket" href="{{ product.url | within: col }}">
                {%- if product.featured_media -%}
                  {{ product.featured_media | image_url: width: 520 | image_tag:
                    widths: '160, 240, 320, 420, 520',
                    sizes: '(min-width: 990px) 170px, 28vw',
                    loading: 'lazy',
                    alt: '',
                    class: 'b-sheet-page__img'
                  }}
                {%- endif -%}
                <span class="b-sheet-page__label">
                  <span class="b-sheet-page__name">{{ f[0] | default: product.title | escape }}</span>
                  <span class="b-sheet-page__price b-mono">{{ product.price | money_without_trailing_zeros }}</span>
                </span>
              </a>
            </li>
            {%- if shown == 9 -%}{%- break -%}{%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..9) -%}<li class="b-sheet-page__slot"><span class="b-sheet-page__pocket">{{ 'product-1' | placeholder_svg_tag: 'b-sheet-page__img b-placeholder' }}</span></li>{%- endfor -%}
        {%- endif -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Binder page (9 pockets)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Turn the page" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Nine pockets from the binder. Tap any card to see both sides up close." },
    { "type": "collection", "id": "collection", "label": "Cards from" },
    { "type": "checkbox", "id": "available_only", "label": "Only show cards in stock", "default": true },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "See the whole binder" }
  ],
  "presets": [{ "name": "Binder page (9 pockets)" }]
}
{% endschema %}
