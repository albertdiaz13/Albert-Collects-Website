<section class="b-section b-prose-section b-prose-section--{{ section.settings.style }}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handle }}"{% endif %} aria-labelledby="ProseTitle-{{ section.id }}">
  <div class="b-wrap b-prosewrap b-prosewrap--{{ section.settings.layout }}">
    <h2 class="b-h2" id="ProseTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}<div class="b-prose b-prosewrap__lede">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="b-panels b-panels--{{ section.settings.layout }}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'panel' -%}
              <div class="b-panel" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}<h3 class="b-h3">{{ block.settings.heading | escape }}</h3>{%- endif -%}
                <div class="b-prose">{{ block.settings.text }}</div>
              </div>
            {%- when 'step' -%}
              <div class="b-panel b-panel--step" {{ block.shopify_attributes }}>
                <h3 class="b-h3">{{ block.settings.heading | escape }}</h3>
                <div class="b-prose">{{ block.settings.text }}</div>
              </div>
            {%- when 'quote' -%}
              <p class="b-pull" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
            {%- when 'button' -%}
              {%- if block.settings.link != blank -%}<p {{ block.shopify_attributes }}><a class="b-btn b-btn--primary" href="{{ block.settings.link }}">{{ block.settings.label | escape }}</a></p>{%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Text panels",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Introduction" },
    { "type": "text", "id": "anchor", "label": "Anchor", "info": "Lets other pages link straight to this section, e.g. raw-vs-graded" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [
      { "value": "stack", "label": "One column" }, { "value": "columns", "label": "Two columns" }, { "value": "steps", "label": "Numbered steps" } ], "default": "stack" },
    { "type": "select", "id": "style", "label": "Background", "options": [
      { "value": "page", "label": "Page" }, { "value": "raised", "label": "Raised panel" }, { "value": "cover", "label": "Cocoa" } ], "default": "page" }
  ],
  "blocks": [
    { "type": "panel", "name": "Panel", "settings": [
      { "type": "text", "id": "heading", "label": "Heading" }, { "type": "richtext", "id": "text", "label": "Text" } ] },
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "heading", "label": "Heading" }, { "type": "richtext", "id": "text", "label": "Text" } ] },
    { "type": "quote", "name": "Large line", "settings": [ { "type": "textarea", "id": "text", "label": "Text" } ] },
    { "type": "button", "name": "Button", "settings": [ { "type": "text", "id": "label", "label": "Label" }, { "type": "url", "id": "link", "label": "Link" } ] }
  ],
  "presets": [{ "name": "Text panels" }]
}
{% endschema %}
