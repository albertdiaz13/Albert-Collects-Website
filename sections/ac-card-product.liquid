{%- comment -%}
  Albert card product page: the large photo flips like the card tiles (button or swipe), opens an inspector with pinch,
  pan and corner shortcuts, and the collector details sit beside the price. Photo 1 is the front and photo 2 the back
  (confirmed by the shop owner). Details come from the listing's own title and tags via ac-card-facts; anything the
  listing doesn't state is left out.
{%- endcomment -%}
{%- liquid
  capture facts
    render 'ac-card-facts', product: product
  endcapture
  assign f = facts | split: '§'
  assign c_name = f[0] | default: product.title
  assign c_number = f[1]
  assign c_set = f[2]
  assign c_lang = f[3]
  assign c_cond = f[4]
  assign c_code = f[5]
  assign c_tier = f[6]
  assign c_print = f[7]
  assign c_year = f[8]
  assign c_notes = f[9]
  assign c_graded = false
  if f[10] == 'true'
    assign c_graded = true
  endif

  comment
    Split the printing the listing states into edition, rarity and finish.
  endcomment
  assign rest = c_print
  assign c_edition = ''
  assign c_finish = ''
  if rest contains '1st Edition'
    assign c_edition = '1st Edition'
    assign rest = rest | remove_first: '1st Edition'
  elsif rest contains 'Unlimited'
    assign c_edition = 'Unlimited'
    assign rest = rest | remove_first: 'Unlimited'
  endif
  assign rest = rest | strip
  assign rest_words = rest | split: ' '
  if rest contains 'Mirror Holo'
    assign c_finish = 'Mirror Holo'
    assign rest = rest | remove_first: 'Mirror Holo'
  elsif rest_words contains 'Holo'
    assign c_finish = 'Holo'
    assign rest = rest | remove_first: 'Holo'
  elsif rest_words contains 'Prism'
    assign c_finish = 'Prism'
    assign rest = rest | remove_first: 'Prism'
  elsif rest_words.first == 'Glossy'
    assign c_finish = 'Glossy'
    assign rest = rest | remove_first: 'Glossy'
  endif
  assign c_rarity = rest | strip
  assign has_swirl = false
  if c_notes contains 'Holo Swirl'
    assign has_swirl = true
  endif

  assign guide_url = ''
  if pages['how-we-condition'] != blank
    assign guide_url = pages['how-we-condition'].url
    if c_graded
      assign guide_url = guide_url | append: '#raw-vs-graded'
    elsif c_tier != blank
      assign guide_url = guide_url | append: '#condition-' | append: c_tier
    endif
  endif

  assign images = product.media | where: 'media_type', 'image'
  assign front = images[0]
  assign back = images[1]
  assign has_back = false
  if back
    assign has_back = true
  endif
  assign variant = product.selected_or_first_available_variant
  assign product_form_id = 'product-form-' | append: section.id
  assign single_copy = false
  if variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny' and variant.inventory_quantity == 1
    assign single_copy = true
  endif

  assign trait_text = product.tags | join: ' ' | append: ' ' | append: product.type | append: ' ' | append: product.title | downcase
  assign traits = ''
  if trait_text contains 'holo' or trait_text contains 'foil'
    assign traits = traits | append: ' holo'
  endif
  if c_graded
    assign traits = traits | append: ' graded'
  endif
  unless product.available
    assign traits = traits | append: ' soldout'
  endunless

  comment
    "About this copy": one or two sentences built only from details this listing states.
  endcomment
  assign s1 = 'A'
  if c_lang != blank
    assign s1 = s1 | append: ' ' | append: c_lang
  endif
  assign s1 = s1 | append: ' ' | append: c_name
  if c_set != blank
    assign s1 = s1 | append: ' from ' | append: c_set
  endif
  if c_year != blank
    assign s1 = s1 | append: ' (' | append: c_year | append: ')'
  endif
  if c_number != blank
    assign num_start = c_number | slice: 0, 3
    if num_start == 'No.' or num_start == 'DPB' or num_start == 'HGS' or num_start == 'SWS'
      assign s1 = s1 | append: ', ' | append: c_number
    else
      assign s1 = s1 | append: ', card ' | append: c_number
    endif
  endif
  assign printed = c_edition | append: ' ' | append: c_rarity | append: ' ' | append: c_finish | strip
  assign printed = printed | replace: '  ', ' '
  if printed != blank
    assign first_char = printed | slice: 0 | upcase
    assign article = 'a'
    if 'AEIOU' contains first_char
      assign article = 'an'
    endif
    assign s1 = s1 | append: ', printed as ' | append: article | append: ' ' | append: printed
  endif
  assign s1 = s1 | append: '.'
  assign lead_char = s1 | slice: 2 | upcase
  if 'AEIOU' contains lead_char
    assign s1 = s1 | replace_first: 'A ', 'An '
  endif
  assign note_phrases = ''
  assign note_items = c_notes | split: ','
  for n in note_items
    case n
      when 'Holo Swirl'
        assign note_phrases = note_phrases | append: 'a holo swirl in the foil|'
      when 'Holo Bleed'
        assign note_phrases = note_phrases | append: 'holo bleed|'
      when 'Creased'
        assign note_phrases = note_phrases | append: 'a crease|'
      when 'Clean Front'
        assign note_phrases = note_phrases | append: 'a clean-looking front|'
    endcase
  endfor
  assign note_list = note_phrases | split: '|'
  assign notes_sentence = note_list | join: ' and '
  assign s2 = ''
  if c_graded and c_cond != blank
    assign s2 = 'This copy is graded ' | append: c_cond
  elsif c_cond != blank
    assign s2 = 'This copy is listed as ' | append: c_cond | append: ' (' | append: c_code | append: ')'
  endif
  if notes_sentence != blank
    if s2 != blank
      assign s2 = s2 | append: ', and the listing notes ' | append: notes_sentence
    else
      assign s2 = 'The listing notes ' | append: notes_sentence
    endif
  endif
  if s2 != blank
    assign s2 = s2 | append: '.'
  endif
-%}

<section class="acp" data-acp>
  <div class="ac-wrap acp__wrap">
    <a class="acp__back" href="{% if collection %}{{ collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">
      <span aria-hidden="true">←</span> {% if collection %}{{ collection.title | escape }}{% else %}Catalog{% endif %}
    </a>

    <div class="acp__grid">
      {%- comment -%} The card: flips like the tiles; a tap or click opens the inspector. {%- endcomment -%}
      <div class="acp__media">
        <div class="acp__card{% if has_back %} ac-has-back{% endif %}"{% if has_back %} data-ac-card{% endif %} data-ac-traits="{{ traits | strip }}">
          <div class="acp__stage-wrap">
            {%- if front -%}
              {%- assign front_alt = 'Front of ' | append: c_name -%}
              <div
                class="ac-image-stage acp__stage"
                data-ac-tilt
                data-ac-holo
                {% if has_back %}data-ac-flip{% endif %}
                data-acp-open
                role="button"
                tabindex="0"
                aria-label="Inspect {{ c_name | escape }} up close"
              >
                <div class="ac-image-plane" data-ac-tilt-plane>
                  <div class="ac-flip" data-ac-flip-inner>
                    <div class="ac-face ac-face--front">
                      {{ front | image_url: width: 1400 | image_tag:
                        widths: '360, 540, 720, 900, 1100, 1400',
                        sizes: '(min-width: 990px) 520px, 82vw',
                        loading: 'eager',
                        fetchpriority: 'high',
                        class: 'ac-product-photo acp__photo',
                        alt: front_alt
                      }}
                      <span class="ac-holo" aria-hidden="true"><span class="ac-holo-spot"></span></span>
                    </div>
                    {%- if has_back -%}
                      {%- assign back_widths = '360,540,720,900,1100,1400' | split: ',' -%}
                      {%- capture back_srcset -%}{%- for w in back_widths -%}{%- assign wn = w | plus: 0 -%}{{ back | image_url: width: wn }} {{ wn }}w{%- unless forloop.last -%}, {% endunless -%}{%- endfor -%}{%- endcapture -%}
                      <div class="ac-face ac-face--back" aria-hidden="true">
                        <img
                          class="ac-product-photo ac-back-photo acp__photo"
                          data-src="{{ back | image_url: width: 900 }}"
                          data-srcset="{{ back_srcset }}"
                          sizes="(min-width: 990px) 520px, 82vw"
                          width="{{ back.width }}"
                          height="{{ back.height }}"
                          alt="Back of {{ c_name | escape }}"
                          decoding="async"
                        >
                      </div>
                    {%- endif -%}
                  </div>
                </div>
                {%- unless product.available -%}<span class="ac-status">Sold out</span>{%- endunless -%}
              </div>
            {%- else -%}
              <div class="acp__nophoto">Photo coming soon</div>
            {%- endif -%}
          </div>

          {%- if front -%}
            <div class="acp__controls">
              {%- if has_back -%}
                <button
                  type="button"
                  class="ac-flip-button acp__flip"
                  data-ac-flip-toggle
                  aria-pressed="false"
                  aria-label="Flip to the back of {{ c_name | escape }}"
                  data-label-alt="Flip to the back of {{ c_name | escape }}"
                  data-label-front="Flip to the front of {{ c_name | escape }}"
                  data-text-alt="See the back"
                  data-text-front="See the front"
                >
                  <span aria-hidden="true" class="ac-flip-icon">↻</span>
                  <span class="ac-flip-text" aria-hidden="true">See the back</span>
                </button>
              {%- endif -%}
              <button type="button" class="acp__inspect" data-acp-open aria-haspopup="dialog">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m15 15 5 5M10.5 8v5M8 10.5h5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                Inspect corners
              </button>
            </div>
            <p class="acp__hint">{% if has_back %}Swipe the card to flip it. {% endif %}Tap it to zoom in.</p>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Collector details, beside the price. {%- endcomment -%}
      <div class="acp__info">
        {%- if product.type != blank -%}<p class="acp__type">{{ product.type | escape }}</p>{%- endif -%}
        <h1 class="acp__name">{{ c_name | escape }}</h1>
        {%- if c_set != blank or c_number != blank -%}
          <p class="acp__sub">{{ c_set | escape }}{% if c_set != blank and c_number != blank %}<span aria-hidden="true"> · </span>{% endif %}{{ c_number | escape }}</p>
        {%- endif -%}

        <div class="acp__price-row">
          {%- if product.available -%}
            <p class="acp__price">{{ variant.price | money }}</p>
          {%- else -%}
            <p class="acp__price acp__price--sold">Sold out</p>
          {%- endif -%}
          {%- if c_cond != blank -%}
            <span class="acp__cond" data-tier="{{ c_tier }}">
              <span class="acp__cond-dot" aria-hidden="true"></span>
              {% if c_graded %}{{ c_cond | escape }}{% else %}{{ c_cond | escape }} <span class="acp__code">{{ c_code }}</span>{% endif %}
            </span>
          {%- endif -%}
        </div>
        {%- assign installment_form_id = 'product-form-installment-' | append: section.id -%}
        {%- form 'product', product, id: installment_form_id, class: 'acp__installments' -%}
          <input type="hidden" name="id" value="{{ variant.id }}">
          {{ form | payment_terms }}
        {%- endform -%}

        <dl class="acp__facts">
          {%- if c_cond != blank -%}
            <div class="acp__fact acp__fact--wide">
              <dt>{% if c_graded %}Grade{% else %}Condition{% endif %}</dt>
              <dd>
                {{ c_cond | escape }}{% unless c_graded %} ({{ c_code }}){% endunless %}
                {%- if guide_url != blank -%}
                  <a class="acp__guide" href="{{ guide_url }}">{% if c_graded %}Raw vs graded, explained{% else %}What {{ c_code | remove: '+' | remove: '-' }} means{% endif %} <span aria-hidden="true">→</span></a>
                {%- endif -%}
              </dd>
            </div>
          {%- endif -%}
          {%- if c_set != blank -%}<div class="acp__fact"><dt>Set</dt><dd>{{ c_set | escape }}</dd></div>{%- endif -%}
          {%- if c_number != blank -%}<div class="acp__fact"><dt>Collector number</dt><dd>{{ c_number | escape }}</dd></div>{%- endif -%}
          {%- if c_lang != blank -%}<div class="acp__fact"><dt>Language</dt><dd>{{ c_lang | escape }}</dd></div>{%- endif -%}
          {%- if c_rarity != blank -%}<div class="acp__fact"><dt>Rarity</dt><dd>{{ c_rarity | escape }}</dd></div>{%- endif -%}
          {%- if c_edition != blank -%}<div class="acp__fact"><dt>Edition</dt><dd>{{ c_edition | escape }}</dd></div>{%- endif -%}
          {%- if c_finish != blank or has_swirl -%}
            <div class="acp__fact"><dt>Finish</dt><dd>{{ c_finish | default: 'Holo' | escape }}{% if has_swirl %}<span class="acp__swirl">with a holo swirl</span>{% endif %}</dd></div>
          {%- endif -%}
          {%- if c_year != blank -%}<div class="acp__fact"><dt>Year</dt><dd>{{ c_year }}</dd></div>{%- endif -%}
        </dl>

        <div class="acp__buy">
          {%- if product.available -%}
            {%- if single_copy -%}
              <p class="acp__single"><span aria-hidden="true">✦</span> One copy: the exact card in these photos.</p>
            {%- elsif variant.inventory_management == 'shopify' and variant.inventory_quantity > 1 -%}
              <div class="acp__qty">
                <label for="Quantity-{{ section.id }}">Quantity</label>
                <quantity-input class="quantity">
                  <button class="quantity__button" name="minus" type="button"><span class="visually-hidden">Decrease quantity</span><span aria-hidden="true">−</span></button>
                  <input class="quantity__input" type="number" name="quantity" id="Quantity-{{ section.id }}" min="1" max="{{ variant.inventory_quantity }}" step="1" value="1" form="{{ product_form_id }}">
                  <button class="quantity__button" name="plus" type="button"><span class="visually-hidden">Increase quantity</span><span aria-hidden="true">+</span></button>
                </quantity-input>
              </div>
            {%- endif -%}
          {%- endif -%}
          {%- liquid
            assign buy_block = section.blocks | where: 'type', 'buy_buttons' | first
          -%}
          {%- if buy_block -%}
            {%- render 'buy-buttons', block: buy_block, product: product, product_form_id: product_form_id, section_id: section.id, show_pickup_availability: false -%}
          {%- endif -%}
        </div>

        <div class="acp__about">
          <h2 class="acp__label">About this copy</h2>
          <p>{{ s1 | escape }}{% if s2 != blank %} {{ s2 | escape }}{% endif %}</p>
        </div>

        {%- assign ship_block = section.blocks | where: 'type', 'shipping' | first -%}
        {%- if ship_block -%}
          <div class="acp__ship" {{ ship_block.shopify_attributes }}>
            <h2 class="acp__label">{{ ship_block.settings.heading | escape }}</h2>
            <div class="acp__ship-text">{{ ship_block.settings.text }}</div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if front -%}
    <dialog class="acp-viewer" data-acp-viewer aria-label="Inspect {{ c_name | escape }}">
      <div class="acp-viewer__top">
        {%- if has_back -%}
          <div class="acp-viewer__sides" role="group" aria-label="Side of the card">
            <button type="button" data-acp-side="front" aria-pressed="true">Front</button>
            <button type="button" data-acp-side="back" aria-pressed="false">Back</button>
          </div>
        {%- else -%}
          <p class="acp-viewer__title">{{ c_name | escape }}</p>
        {%- endif -%}
        <button type="button" class="acp-viewer__close" data-acp-close>Close <span aria-hidden="true">✕</span></button>
      </div>
      <div class="acp-viewer__stage" data-acp-stage tabindex="0" aria-label="Photo. Use plus and minus to zoom and the arrow keys to look around.">
        {%- assign front_w = front.width | at_most: 3000 -%}
        <img data-acp-img="front" data-src="{{ front | image_url: width: front_w }}" width="{{ front.width }}" height="{{ front.height }}" alt="Front of {{ c_name | escape }}, full size" draggable="false">
        {%- if has_back -%}
          {%- assign back_w = back.width | at_most: 3000 -%}
          <img data-acp-img="back" data-src="{{ back | image_url: width: back_w }}" width="{{ back.width }}" height="{{ back.height }}" alt="Back of {{ c_name | escape }}, full size" draggable="false" hidden>
        {%- endif -%}
      </div>
      <div class="acp-viewer__bottom">
        <div class="acp-viewer__corners" role="group" aria-label="Jump to a corner">
          <button type="button" data-acp-corner="tl" aria-label="Top-left corner"><span class="acp-corner acp-corner--tl" aria-hidden="true"></span></button>
          <button type="button" data-acp-corner="tr" aria-label="Top-right corner"><span class="acp-corner acp-corner--tr" aria-hidden="true"></span></button>
          <button type="button" data-acp-corner="bl" aria-label="Bottom-left corner"><span class="acp-corner acp-corner--bl" aria-hidden="true"></span></button>
          <button type="button" data-acp-corner="br" aria-label="Bottom-right corner"><span class="acp-corner acp-corner--br" aria-hidden="true"></span></button>
        </div>
        <div class="acp-viewer__zoom">
          <button type="button" data-acp-zoom="-1" aria-label="Zoom out">−</button>
          <button type="button" data-acp-fit>Whole card</button>
          <button type="button" data-acp-zoom="1" aria-label="Zoom in">+</button>
        </div>
        <p class="acp-viewer__hint">Pinch or scroll to zoom. Drag to look around.</p>
      </div>
      <p class="visually-hidden" aria-live="polite" data-acp-status></p>
    </dialog>
  {%- endif -%}

  <script type="application/ld+json">{{ product | structured_data }}</script>
</section>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Card product",
  "class": "acp-section",
  "blocks": [
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show Shop Pay and other express checkout buttons", "default": true }
      ]
    },
    {
      "type": "shipping",
      "name": "Shipping",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Shipping options and costs appear at checkout, before you pay.</p>" }
      ]
    }
  ]
}
{% endschema %}
