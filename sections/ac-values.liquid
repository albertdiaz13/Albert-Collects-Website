<section class="page-width"><div class="ac-values">{% for block in section.blocks %}<article {{ block.shopify_attributes }}><span class="ac-star" aria-hidden="true">✦</span><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.body | escape }}</p></article>{% endfor %}</div></section>
{% schema %}{"name": "Collector values", "settings": [], "blocks": [{"type": "value", "name": "Value", "settings": [{"type": "text", "id": "title", "label": "Title", "default": "Curated with care"}, {"type": "textarea", "id": "body", "label": "Text", "default": "Thoughtful finds for your collection."}]}], "max_blocks": 3, "presets": [{"name": "Collector values"}]}{% endschema %}