{%- comment -%}
  Event spotlight on the homepage (generic Albert Collects theme): a condensed version of the kiosk's Showcase
  (snippets/ac-showcase.liquid), with the same slow drift of real cards, the same tap and swipe responses, and one
  button to the live inventory. The cards are the first available products of the collection chosen in
  Theme settings > Albert extras > Event collection; the button opens that collection, which is the kiosk.

  With no collection chosen, or an empty one, shoppers on the published theme see nothing at all. The theme editor and
  unpublished previews show a setup message instead, so the section is easy to find before launch.
{%- endcomment -%}
{%- liquid
  assign event = settings.ac_event_collection
  assign has_stock = false
  if event != blank and event.products_count > 0
    assign has_stock = true
  endif
  assign kiosk_url = event.url
  assign show_setup = false
  if request.design_mode or theme.role == 'unpublished' or theme.role == 'development'
    assign show_setup = true
  endif
-%}
{%- if has_stock -%}
  {{ 'albert-showcase.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'albert-showcase.js' | asset_url }}" defer="defer"></script>
  {%- capture acs_items -%}
    {%- for item in event.products limit: 12 -%}
      {%- if item.available and item.featured_media != blank -%}
        <i data-acs-item data-ref="{{ item.id }}" data-name="{{ item.title | escape }}" data-price="{{ item.price | money | strip_html | escape }}" data-img="{{ item.featured_media.preview_image | image_url: width: 360 }}" data-url="{{ item.url }}" data-meta="{{ item.type | escape }}" data-tag="Available today"></i>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  <section class="ac-racket acs-home ac-wrap" data-ac-context="racket" aria-labelledby="ac-racket-title-{{ section.id }}">
    {% render 'ac-showcase', mode: 'home', items: acs_items %}
    <div class="acs-copy">
      {%- if section.settings.eyebrow != blank -%}<p class="acs-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="ac-racket-title-{{ section.id }}">{{ section.settings.title | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="acs-text">{{ section.settings.text | escape }}</p>{%- endif -%}
      <a class="acs-cta ac-racket-button" href="{{ kiosk_url }}"><span>{{ section.settings.button_label | default: 'Browse Available Cards' | escape }}</span><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M5 12h13M13 6.500l5.500 5.500-5.500 5.500" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
    </div>
  </section>
{%- elsif show_setup -%}
  {{ 'albert-racket.css' | asset_url | stylesheet_tag }}
  <section class="ac-racket ac-racket--setup ac-wrap" aria-label="Event spotlight setup">
    <div class="ac-racket-copy">
      <p class="ac-kicker">SETUP · ONLY VISIBLE IN THE EDITOR AND UNPUBLISHED PREVIEWS</p>
      <h2>{{ section.settings.title | escape }}</h2>
      {%- if event == blank -%}
        <p class="ac-racket-text">This spotlight is waiting for its collection. In the theme editor open Theme settings (the paintbrush) > Albert extras and choose the Event collection. Shoppers on the live theme see nothing here until it has at least one product.</p>
      {%- else -%}
        <p class="ac-racket-text">The collection "{{ event.title | escape }}" is assigned but has no products yet. Add products to it in Shopify admin and the first three appear here. Shoppers on the live theme see nothing until then.</p>
        <a class="ac-racket-button" href="{{ kiosk_url }}"><span>Preview the empty kiosk page</span></a>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Albert event spotlight",
  "settings": [
    {
      "type": "paragraph",
      "content": "Products come from Theme settings > Albert extras > Event collection. The first three show here."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "LIVE AT TODAY'S SHOW"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Discover What's on Display"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Explore the cards available at today's show."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Browse Available Cards"
    }
  ],
  "presets": [
    {
      "name": "Albert event spotlight"
    }
  ]
}
{% endschema %}
