{%- comment -%}
  Price display.
  - product (required) / variant (optional, defaults to selected or first available)
  - show_from (boolean): use "From" when prices vary
  - unit (string): optional unit label such as "per 100 stickers"
{%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign price = target.price
  assign compare = target.compare_at_price
  if show_from and product.price_varies
    assign price = product.price_min
    assign compare = nil
  endif
  if settings.currency_code_enabled
    assign price_html = price | money_with_currency
    assign compare_html = compare | money_with_currency
  else
    assign price_html = price | money
    assign compare_html = compare | money
  endif
-%}
<span class="fc-price{% if compare > price %} fc-price--sale{% endif %}" data-fc-price>
  {%- if compare > price -%}
    <span class="fc-visually-hidden">{{ 'products.regular_price' | t }}</span>
    <s class="fc-price__compare" data-fc-compare>{{ compare_html }}</s>
    <span class="fc-visually-hidden">{{ 'products.sale_price' | t }}</span>
  {%- endif -%}
  <span class="fc-price__amount" data-fc-amount>
    {%- if show_from and product.price_varies -%}
      {{ 'products.from_price' | t: price: price_html }}
    {%- else -%}
      {{ price_html }}
    {%- endif -%}
  </span>
  {%- if unit != blank -%}
    <span class="fc-price__unit">{{ unit }}</span>
  {%- endif -%}
</span>
