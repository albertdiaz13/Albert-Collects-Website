{%- comment -%}
  Inline SVG icons. Usage: {% render 'fc-icon', icon: 'cart' %}
{%- endcomment -%}
{%- case icon -%}
  {%- when 'search' -%}
    <svg class="fc-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="24" height="24"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  {%- when 'cart' -%}
    <svg class="fc-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="24" height="24"><path d="M3 4h2.2l2.3 11.2a1.5 1.5 0 0 0 1.5 1.2h8.6a1.5 1.5 0 0 0 1.5-1.1L21 8H6.3" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/><circle cx="9.5" cy="20" r="1.4" fill="currentColor"/><circle cx="17" cy="20" r="1.4" fill="currentColor"/></svg>
  {%- when 'menu' -%}
    <svg class="fc-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="24" height="24"><path d="M3 7h18M3 12h18M3 17h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  {%- when 'close' -%}
    <svg class="fc-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="24" height="24"><path d="M5 5l14 14M19 5 5 19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  {%- when 'arrow' -%}
    <svg class="fc-icon fc-icon--arrow" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="24" height="24"><path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'arrow-left' -%}
    <svg class="fc-icon fc-icon--arrow" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="24" height="24"><path d="M20 12H5M11 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'plus' -%}
    <svg class="fc-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="24" height="24"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  {%- when 'minus' -%}
    <svg class="fc-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="24" height="24"><path d="M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  {%- when 'pin' -%}
    <svg class="fc-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="24" height="24"><path d="M12 21s-6.5-6.2-6.5-11.2a6.5 6.5 0 0 1 13 0C18.5 14.8 12 21 12 21Z" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="9.8" r="2.3" fill="currentColor"/></svg>
  {%- when 'clock' -%}
    <svg class="fc-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="24" height="24"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 7.5V12l3 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  {%- when 'instagram' -%}
    <svg class="fc-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="24" height="24"><rect x="3.5" y="3.5" width="17" height="17" rx="4.5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.2" cy="6.8" r="1.2" fill="currentColor"/></svg>
  {%- when 'tiktok' -%}
    <svg class="fc-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="24" height="24"><path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.4 2.6 2.2 4.4 5 4.6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  {%- when 'facebook' -%}
    <svg class="fc-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="24" height="24"><path d="M14.5 21v-7.5H17l.5-3h-3V8.6c0-.9.4-1.6 1.7-1.6h1.4V4.3c-.6-.1-1.5-.2-2.4-.2-2.5 0-4 1.5-4 4.2v2.2H9.5v3h2.7V21" fill="currentColor"/></svg>
  {%- when 'youtube' -%}
    <svg class="fc-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="24" height="24"><rect x="2.5" y="5.5" width="19" height="13" rx="3.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="m10 9 5 3-5 3Z" fill="currentColor"/></svg>
  {%- when 'twitter' -%}
    <svg class="fc-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="24" height="24"><path d="M4 4l16 16M20 4 4 20" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
{%- endcase -%}
