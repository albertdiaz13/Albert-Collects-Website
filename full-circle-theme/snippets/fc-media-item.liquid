<li class="fc-gallery__item fc-gallery__item--{{ media.media_type }}" data-media-id="{{ media.id }}" aria-label="{{ 'products.media_label' | t: index: index, count: count }}">
  {%- case media.media_type -%}
    {%- when 'image' -%}
      {%- liquid
        assign img_loading = 'lazy'
        if eager
          assign img_loading = 'eager'
        endif
        assign media_alt = media.alt | default: product.title
      -%}
      {% render 'fc-image', image: media.preview_image, widths: '400, 600, 800, 1000, 1300, 1600', sizes: '(min-width: 990px) 56vw, 100vw', class: 'fc-gallery__img', loading: img_loading, alt: media_alt, priority: eager %}
    {%- when 'video' -%}
      {{ media | video_tag: controls: true, preload: 'metadata', class: 'fc-gallery__video' }}
    {%- when 'external_video' -%}
      <div class="fc-gallery__embed">{{ media | external_video_tag }}</div>
    {%- when 'model' -%}
      {{ media | model_viewer_tag: image_size: '1200x', reveal: 'interaction', toggleable: true }}
    {%- else -%}
      {{ media | media_tag }}
  {%- endcase -%}
</li>
