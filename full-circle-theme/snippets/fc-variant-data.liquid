{%- comment -%}
  Variant data for the picker script. Prices are in the store's subunit (cents).
{%- endcomment -%}
<script type="application/json" data-fc-variants>
  [
    {%- for v in product.variants -%}
      {
        "id": {{ v.id }},
        "options": {{ v.options | json }},
        "price": {{ v.price }},
        "compare": {{ v.compare_at_price | default: 0 }},
        "available": {{ v.available | json }},
        "tracked": {% if v.inventory_management == 'shopify' and v.inventory_policy == 'deny' %}true{% else %}false{% endif %},
        "left": {% if v.inventory_management == 'shopify' and v.inventory_policy == 'deny' %}{{ v.inventory_quantity | at_least: 0 }}{% else %}null{% endif %},
        "media": {% if v.featured_media %}{{ v.featured_media.id }}{% else %}null{% endif %}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
</script>
