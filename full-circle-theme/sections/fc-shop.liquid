{{ 'fc-shop.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = settings.merch_collection
  endif
  if source == blank
    assign source = collections.all
  endif
-%}
{%- comment -%}
  Products come straight from the chosen collection, three per row on desktop. A fourth product
  starts a new row with the same treatment.
{%- endcomment -%}
<section class="fc-shop" data-section-id="{{ section.id }}" aria-labelledby="ShopTitle-{{ section.id }}">
  <div class="fc-shop__inner">
    <header class="fc-shop__head">
      <div class="fc-shop__headline">
        {%- if section.settings.kicker != blank -%}
          <p class="fc-kicker">{{ section.settings.kicker | escape }}</p>
        {%- endif -%}
        <h2 class="fc-shop__title" id="ShopTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      </div>
      <nav class="fc-chips" aria-label="{{ section.settings.heading | escape }}">
        <ul role="list">
          {%- for block in section.blocks -%}
            {%- assign c = block.settings.collection -%}
            {%- if c == blank -%}{%- continue -%}{%- endif -%}
            {%- if c.products_count == 0 and section.settings.show_empty == false -%}{%- continue -%}{%- endif -%}
            <li {{ block.shopify_attributes }}>
              <a class="fc-chip" href="{{ c.url }}"><span>{{ block.settings.label | default: c.title | escape }}</span><span class="fc-chip__count">{{ c.products_count }}</span></a>
            </li>
          {%- endfor -%}
          <li><a class="fc-chip fc-chip--all" href="{{ source.url }}"><span>{{ 'general.view_all' | t }}</span>{% render 'fc-icon', icon: 'arrow' %}</a></li>
        </ul>
      </nav>
    </header>

    {%- if source.products.size > 0 -%}
      <ul class="fc-shop__grid" role="list">
        {%- for product in source.products limit: section.settings.limit -%}
          <li class="fc-shop__item">
            {%- if forloop.index <= 3 -%}
              {% render 'fc-shop-card', product: product, eager: true %}
            {%- else -%}
              {% render 'fc-shop-card', product: product %}
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="fc-empty">{{ 'collections.empty' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop",
  "tag": "div",
  "class": "fc-section-shop",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Featured merchandise", "info": "Defaults to the merchandise collection in Theme settings. Keep vending tables out of this collection." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 3, "max": 12, "step": 3, "default": 6 },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Merch & supplies" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
    { "type": "checkbox", "id": "show_empty", "label": "Show collection links with no products", "default": false }
  ],
  "blocks": [
    {
      "type": "collection_link",
      "name": "Collection link",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label", "info": "Defaults to the collection title." }
      ]
    }
  ],
  "presets": [{ "name": "Shop" }]
}
{% endschema %}
