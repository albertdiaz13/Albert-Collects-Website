{{ 'fc-event-night.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  One recurring event, set like a Friday-night poster. All text is editable in the theme editor.
  The ring echoes the hero's orbit, so the hero's expanding ring hands off to this badge.
{%- endcomment -%}
<section class="fc-night" data-section-id="{{ section.id }}" aria-labelledby="NightTitle-{{ section.id }}">
  <div class="fc-night__inner">
    <div class="fc-night__badge" aria-hidden="true">
      <svg class="fc-night__ring" viewBox="0 0 200 200" focusable="false">
        <circle class="fc-night__track" cx="100" cy="100" r="92" pathLength="100" />
        <circle class="fc-night__arc" cx="100" cy="100" r="92" pathLength="100" />
      </svg>
      <span class="fc-night__badge-text">
        {%- if section.settings.badge_top != blank -%}<span class="fc-night__badge-top">{{ section.settings.badge_top | escape }}</span>{%- endif -%}
        <span class="fc-night__badge-day">{{ section.settings.badge_day | escape }}</span>
      </span>
    </div>

    <div class="fc-night__copy">
      {%- if section.settings.kicker != blank -%}
        <p class="fc-night__kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      <h2 class="fc-night__title" id="NightTitle-{{ section.id }}">{{ section.settings.title | escape }}</h2>
      <dl class="fc-night__facts">
        <div class="fc-night__fact">
          <dt class="fc-visually-hidden">When</dt>
          <dd class="fc-night__when">{% render 'fc-icon', icon: 'clock' %}<span>{% render 'fc-nowrap-parts', text: section.settings.schedule %}</span></dd>
        </div>
        <div class="fc-night__fact">
          <dt class="fc-visually-hidden">Where</dt>
          <dd class="fc-night__where">{% render 'fc-icon', icon: 'pin' %}<span>{% render 'fc-nowrap-parts', text: section.settings.venue %}</span></dd>
        </div>
      </dl>
      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <a class="fc-button fc-button--large fc-button--crimson fc-night__cta" href="{{ section.settings.link }}">
          <span>{{ section.settings.link_label | escape }}</span>{% render 'fc-icon', icon: 'arrow' %}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Recurring event",
  "tag": "div",
  "class": "fc-section-night",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Weekly trade night" },
    { "type": "text", "id": "title", "label": "Event name", "default": "ORS TCG Trade Nights" },
    { "type": "text", "id": "schedule", "label": "Day and time", "default": "Every Friday · 5:00 PM–9:30 PM" },
    { "type": "text", "id": "venue", "label": "Venue", "default": "Orlando Racket Sports · Orange Blossom Trail" },
    { "type": "text", "id": "badge_top", "label": "Badge, small line", "default": "Every" },
    { "type": "text", "id": "badge_day", "label": "Badge, day", "default": "Fri" },
    { "type": "text", "id": "link_label", "label": "Button label", "info": "Optional. Shown only with a link." },
    { "type": "url", "id": "link", "label": "Button link" }
  ],
  "presets": [{ "name": "Recurring event" }]
}
{% endschema %}
