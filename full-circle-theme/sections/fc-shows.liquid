{{ 'fc-shows.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = settings.vending_collection
  endif
  assign all_url = source.url | default: settings.vending_collection.url | default: '/collections/vending-tables'
-%}
<section class="fc-shows fc-shows--{{ section.settings.scheme }}" data-fc-shows data-section-id="{{ section.id }}" aria-labelledby="ShowsTitle-{{ section.id }}">
  <div class="fc-shows__inner">
    <header class="fc-shows__head">
      {%- if section.settings.kicker != blank -%}
        <p class="fc-kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      <h2 class="fc-shows__title" id="ShowsTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="fc-shows__text">{{ section.settings.text }}</div>
      {%- endif -%}
      <a class="fc-link-button fc-shows__all" href="{{ all_url }}">
        {{- 'events.all_shows' | t -}}
        {% render 'fc-icon', icon: 'arrow' %}
      </a>
    </header>
    <div class="fc-shows__rule" aria-hidden="true" data-fc-rule></div>
    {%- if source != blank -%}
      {% render 'fc-event-list', events: source.products, limit: section.settings.limit, context: 'home', heading_level: 3 %}
    {%- else -%}
      {% render 'fc-event-list', events: blank, limit: 0, context: 'home' %}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Upcoming shows",
  "tag": "div",
  "class": "fc-section-shows",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Vending tables collection",
      "info": "Defaults to the collection in Theme settings › Shop & booking. Each show is one event product."
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Vending tables"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Upcoming shows"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "info": "Optional. For example, who the shows are for."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Shows to list",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Color",
      "options": [
        { "value": "ink", "label": "Ink" },
        { "value": "paper", "label": "Paper" }
      ],
      "default": "ink"
    }
  ],
  "presets": [
    {
      "name": "Upcoming shows"
    }
  ]
}
{% endschema %}
