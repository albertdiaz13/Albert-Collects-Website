{{ 'fc-hero.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign shop_url = section.settings.primary_url | default: settings.merch_collection.url | default: routes.all_products_collection_url
  assign book_url = section.settings.secondary_url | default: settings.vending_collection.url | default: '/collections/vending-tables'
-%}
{%- comment -%}
  The logo is built from five layers cut from the original artwork on one shared canvas
  (1671 × 1700), so stacked at rest they are the original logo. Without the motion script,
  or with reduced motion, the single original image is shown instead.
{%- endcomment -%}
{%- assign layered = false -%}
{%- if section.settings.logo == blank -%}{%- assign layered = true -%}{%- endif -%}
<section class="fc-hero" data-fc-hero data-section-id="{{ section.id }}" aria-labelledby="HeroTitle-{{ section.id }}">
  <div class="fc-hero__inner">
    <div class="fc-hero__stage">
      <button class="fc-hero__mark" type="button" data-fc-logo{% if layered %} data-fc-layered{% endif %} aria-describedby="HeroLogoHint-{{ section.id }}">
        {%- if section.settings.logo != blank -%}
          {%- assign logo_alt = section.settings.logo.alt | default: shop.name -%}
          {{ section.settings.logo | image_url: width: 1100 | image_tag: class: 'fc-hero__logo', alt: logo_alt, loading: 'eager', fetchpriority: 'high', widths: '400, 600, 800, 1100', sizes: '(min-width: 990px) 480px, 70vw' }}
        {%- else -%}
          <img class="fc-hero__logo" src="{{ 'fc-logo-hero.webp' | asset_url }}" alt="{{ shop.name | escape }}" width="1100" height="1119" loading="eager" fetchpriority="high">
          <span class="fc-hero__layers" aria-hidden="true">
            {%- assign logo_parts = 'ring,stroke,text-black,text-red,crimson' | split: ',' -%}
            {%- for part in logo_parts -%}
              <span class="fc-layer fc-layer--{{ part }}" data-layer="{{ part }}"><img src="{{ 'fc-logo-' | append: part | append: '.webp' | asset_url }}" alt="" width="1100" height="1119" loading="eager" decoding="async"></span>
            {%- endfor -%}
          </span>
        {%- endif -%}
      </button>
      <span class="fc-visually-hidden" id="HeroLogoHint-{{ section.id }}">Press to roll the crimson mark along the ink stroke.</span>
    </div>

    <div class="fc-hero__copy">
      <h1 class="fc-hero__title" id="HeroTitle-{{ section.id }}">{{ section.settings.headline | escape }}</h1>
      {%- if section.settings.subheading != blank -%}
        <div class="fc-hero__sub">{{ section.settings.subheading }}</div>
      {%- endif -%}
      <div class="fc-hero__actions">
        {%- if section.settings.primary_label != blank -%}
          <a class="fc-button fc-button--large" href="{{ shop_url }}">
            <span>{{ section.settings.primary_label | escape }}</span>
            {% render 'fc-icon', icon: 'arrow' %}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a class="fc-button fc-button--large fc-button--crimson" href="{{ book_url }}">
            <span>{{ section.settings.secondary_label | escape }}</span>
            {% render 'fc-icon', icon: 'arrow' %}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "div",
  "class": "fc-section-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Defaults to the transparent Full Circle lockup bundled with the theme. Use a transparent PNG or WebP of the full circular logo so the rings line up."
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Gear for the hobby. Tables at the show."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Supporting text"
    },
    {
      "type": "header",
      "content": "Actions"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Shop button label",
      "default": "Shop products"
    },
    {
      "type": "url",
      "id": "primary_url",
      "label": "Shop button link",
      "info": "Defaults to the merchandise collection in Theme settings."
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Booking button label",
      "default": "Book vending tables"
    },
    {
      "type": "url",
      "id": "secondary_url",
      "label": "Booking button link",
      "info": "Defaults to the vending tables collection in Theme settings."
    }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
