{{ 'fc-hero.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign shop_url = section.settings.primary_url | default: settings.merch_collection.url | default: routes.all_products_collection_url
  assign book_url = section.settings.secondary_url | default: settings.vending_collection.url | default: '/collections/vending-tables'
  assign use_bundled = false
  if section.settings.image == blank and section.settings.use_bundled_art
    assign use_bundled = true
  endif
  assign breakout = section.settings.breakout_image
  assign show_breakout = false
  if breakout != blank or use_bundled
    assign show_breakout = true
  endif
  assign frame_style = ''
  if use_bundled
    assign bx = 71.7
    assign by = 66
    assign bd = 41.8
    assign frame_style = '--z: 1.1; --sx: 5; --sy: 2; --pop: 1.07;'
  else
    assign bx = section.settings.breakout_x
    assign by = section.settings.breakout_y
    assign bd = section.settings.breakout_size
  endif
-%}
<section class="fc-hero" data-fc-hero data-section-id="{{ section.id }}" aria-labelledby="HeroTitle-{{ section.id }}">
  <div class="fc-hero__grid">
    <div class="fc-hero__copy">
      {%- if section.settings.kicker != blank -%}
        <p class="fc-kicker fc-hero__kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      <h1 class="fc-hero__title" id="HeroTitle-{{ section.id }}">{{ section.settings.headline | escape | newline_to_br }}</h1>
      {%- if section.settings.show_stroke -%}
        <div class="fc-hero__stroke" aria-hidden="true" data-fc-hero-stroke>
          <img class="fc-hero__stroke-img" src="{{ 'fc-brush-stroke.webp' | asset_url }}" alt="" width="1323" height="199" loading="eager">
          <img class="fc-hero__dot" src="{{ 'fc-crimson-ring.webp' | asset_url }}" alt="" width="90" height="88" loading="eager" data-fc-hero-dot>
        </div>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="fc-hero__sub">{{ section.settings.subheading }}</div>
      {%- endif -%}
      <div class="fc-hero__actions">
        {%- if section.settings.primary_label != blank -%}
          <a class="fc-button fc-button--large" href="{{ shop_url }}">
            <span>{{ section.settings.primary_label | escape }}</span>
            {% render 'fc-icon', icon: 'arrow' %}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a class="fc-button fc-button--large fc-button--crimson" href="{{ book_url }}">
            <span>{{ section.settings.secondary_label | escape }}</span>
            {% render 'fc-icon', icon: 'arrow' %}
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="fc-hero__art">
      <div class="fc-hero__frame" style="--bx: {{ bx }}; --by: {{ by }}; --bd: {{ bd }}; {{ frame_style }}" data-fc-hero-frame>
        <div class="fc-hero__reveal" data-fc-hero-reveal>
          <div class="fc-hero__photo">
            {%- if section.settings.image != blank -%}
              {% render 'fc-image', image: section.settings.image, widths: '400, 600, 800, 1000, 1200, 1500', sizes: '(min-width: 990px) 52vw, 92vw', class: 'fc-hero__img', loading: 'eager', priority: true %}
            {%- elsif use_bundled -%}
              <img class="fc-hero__img" src="{{ 'fc-hero-stickers.webp' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" width="1400" height="1400" loading="eager" fetchpriority="high">
            {%- else -%}
              <span class="fc-hero__empty">
                <img src="{{ 'fc-mark.webp' | asset_url }}" alt="" width="256" height="236">
              </span>
            {%- endif -%}
          </div>
          <img class="fc-hero__ring" src="{{ 'fc-brush-ring.webp' | asset_url }}" alt="" width="1300" height="1200" loading="eager">
        </div>
        {%- if show_breakout -%}
          <div class="fc-hero__breakout" data-fc-hero-breakout>
            {%- if breakout != blank -%}
              {{ breakout | image_url: width: 900 | image_tag: class: 'fc-hero__breakout-img', alt: '', loading: 'eager', widths: '300, 450, 600, 900', sizes: '(min-width: 990px) 22vw, 40vw' }}
            {%- else -%}
              <img class="fc-hero__breakout-img" src="{{ 'fc-hero-sticker.webp' | asset_url }}" alt="" width="900" height="900" loading="eager">
            {%- endif -%}
            {%- if section.settings.idle_effect == 'foil' -%}
              <span class="fc-hero__foil" aria-hidden="true"></span>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "div",
  "class": "fc-section-hero",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Full Circle Collaborations"
    },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Headline",
      "info": "Line breaks are kept. Keep it short — it is set very large.",
      "default": "Gear for the hobby.\nTables at the show."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Supporting text",
      "default": "<p>Custom stickers for your card business, hats and collector supplies — plus vending tables at the shows we host.</p>"
    },
    {
      "type": "header",
      "content": "Actions"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Shop button label",
      "default": "Shop products"
    },
    {
      "type": "url",
      "id": "primary_url",
      "label": "Shop button link",
      "info": "Defaults to the merchandise collection in Theme settings."
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Booking button label",
      "default": "Book vending tables"
    },
    {
      "type": "url",
      "id": "secondary_url",
      "label": "Booking button link",
      "info": "Defaults to the vending tables collection in Theme settings."
    },
    {
      "type": "header",
      "content": "Artwork"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Circle image",
      "info": "A real product detail or show photo. Shown inside the brush circle. Set the focal point in the image editor."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Bundled image description",
      "default": "A fanned stack of round holographic Full Circle Collaborations stickers"
    },
    {
      "type": "checkbox",
      "id": "use_bundled_art",
      "label": "Use bundled sticker photo when no image is chosen",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "breakout_image",
      "label": "Breakout cutout",
      "info": "Optional transparent PNG of one item from the circle image. It is placed over the photo and allowed to cross the brush edge."
    },
    {
      "type": "range",
      "id": "breakout_x",
      "label": "Breakout center, horizontal",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 72
    },
    {
      "type": "range",
      "id": "breakout_y",
      "label": "Breakout center, vertical",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 66
    },
    {
      "type": "range",
      "id": "breakout_size",
      "label": "Breakout size",
      "min": 10,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 42
    },
    {
      "type": "select",
      "id": "idle_effect",
      "label": "Idle effect",
      "options": [
        { "value": "foil", "label": "Light moving across foil" },
        { "value": "none", "label": "None" }
      ],
      "default": "foil"
    },
    {
      "type": "checkbox",
      "id": "show_stroke",
      "label": "Show ink stroke and crimson ring",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
