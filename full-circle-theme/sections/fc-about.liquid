{{ 'fc-about.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Compact About strip. The header's About link points at #about.
  The photo slot stays empty until the client supplies an approved event photo.
{%- endcomment -%}
<section class="fc-about" id="{{ section.settings.anchor | default: 'about' | handle }}" data-section-id="{{ section.id }}" aria-labelledby="AboutTitle-{{ section.id }}" tabindex="-1">
  <div class="fc-about__inner{% if section.settings.photo != blank %} has-photo{% endif %}">
    {%- if section.settings.photo != blank -%}
      <figure class="fc-about__photo">
        {%- assign photo_alt = section.settings.photo.alt | default: section.settings.photo_caption -%}
        {% render 'fc-image', image: section.settings.photo, widths: '360, 540, 720, 900', sizes: '(min-width: 750px) 320px, 92vw', class: 'fc-about__img', alt: photo_alt %}
        {%- if section.settings.photo_caption != blank -%}<figcaption>{{ section.settings.photo_caption | escape }}</figcaption>{%- endif -%}
      </figure>
    {%- else -%}
      <span class="fc-about__mark" aria-hidden="true">
        <img src="{{ 'fc-mark.webp' | asset_url }}" alt="" width="256" height="236" loading="lazy">
      </span>
    {%- endif -%}
    <div class="fc-about__copy">
      <h2 class="fc-about__title" id="AboutTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<div class="fc-about__text fc-rte">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.night != blank -%}<p class="fc-about__night">{{ section.settings.night | escape }}</p>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About",
  "tag": "div",
  "class": "fc-section-about",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Link anchor", "info": "The header's About link goes to /#about.", "default": "about" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "About Full Circle" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Custom stickers, hats and supplies for the trading-card hobby.</p>" },
    { "type": "text", "id": "night", "label": "Trade-night line", "default": "Every Friday, 5:00–9:30 PM, ORS TCG Trade Nights bring collectors to Orlando Racket Sports on Orange Blossom Trail to buy, sell and trade." },
    { "type": "image_picker", "id": "photo", "label": "Event photo", "info": "Optional. Use an approved photo from a trade night. Without one, the brush mark is shown." },
    { "type": "text", "id": "photo_caption", "label": "Photo caption" }
  ],
  "presets": [{ "name": "About" }]
}
{% endschema %}
