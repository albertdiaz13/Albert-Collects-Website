<section class="fc-password">
  <img class="fc-password__logo" src="{{ 'fc-lockup.webp' | asset_url }}" alt="{{ shop.name | escape }}" width="320" height="325">
  {%- if shop.password_message != blank -%}<p class="fc-password__msg">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password', class: 'fc-password__form' -%}
    {%- if form.errors -%}<p class="fc-form-error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    <label class="fc-label" for="Password">{{ 'general.password_label' | t }}</label>
    <div class="fc-search-form">
      <input class="fc-input" type="password" name="password" id="Password" autocomplete="current-password">
      <button class="fc-button" type="submit">{{ 'general.password_submit' | t }}</button>
    </div>
  {%- endform -%}
</section>
{% schema %}
{ "name": "Password", "tag": "div", "settings": [] }
{% endschema %}
