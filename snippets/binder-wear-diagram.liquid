{%- comment -%}
  Illustration of where wear shows on a card back, by condition. Accepts: tier (nm, lp, mp, hp, dmg), id, label.
  It's a drawing, not a photo of any listing.
{%- endcomment -%}
<svg class="b-wear" viewBox="0 0 126 176" role="img" aria-labelledby="Wear-{{ tier }}-{{ id }}" focusable="false">
  <title id="Wear-{{ tier }}-{{ id }}">{{ label }}</title>
  <rect x="3" y="3" width="120" height="170" rx="9" fill="#24448f"/>
  <rect x="11" y="11" width="104" height="154" rx="5" fill="#2f57ad"/>
  <circle cx="63" cy="88" r="27" fill="#24448f"/>
  <circle cx="63" cy="88" r="11" fill="#f2be45"/>
  <g fill="#fff">
  {%- case tier -%}
    {%- when 'nm' -%}
      <circle cx="121" cy="44" r="2.2"/>
    {%- when 'lp' -%}
      <circle cx="121" cy="44" r="2.6"/><circle cx="5" cy="122" r="2.4"/><circle cx="72" cy="171" r="2.2"/>
      <path d="M110 3h5a8 8 0 0 1 8 8v5l-5-3-4-6z"/>
      <path d="M38 58l34 24" stroke="#fff" stroke-width="2" stroke-linecap="round" opacity=".9"/>
    {%- when 'mp' -%}
      <path d="M3 28v56l4-2.5-.8-51z"/><path d="M123 88v58l-4-3 .8-52z"/><path d="M30 3h48l-2.5 4-43-.6z"/>
      <path d="M3 12a9 9 0 0 1 9-9h7l-9 5-6 8z"/><path d="M123 164a9 9 0 0 1-9 9h-7l9-5 6-8z"/>
      <path d="M28 48l52 40M34 56l40 32M44 124l32-15" stroke="#fff" stroke-width="2" stroke-linecap="round" opacity=".85"/>
      <path d="M3 142q30-5 60 2" stroke="#fff" stroke-width="2.4" fill="none" opacity=".6"/>
    {%- when 'hp' -%}
      <path d="M3 12v152l4.5-3V15z"/><path d="M123 12v152l-4.5-3V15z"/><path d="M12 3h102l-3 4.5H15z"/><path d="M12 173h102l-3-4.5H15z"/>
      <path d="M3 12a9 9 0 0 1 9-9h8l-11 6-6 9zM123 12a9 9 0 0 0-9-9h-8l11 6 6 9zM3 164a9 9 0 0 0 9 9h8l-11-6-6-9zM123 164a9 9 0 0 1-9 9h-8l11-6 6-9z"/>
      <rect x="18" y="22" width="90" height="62" rx="8" opacity=".28"/>
      <path d="M3 106 123 92" stroke="#fff" stroke-width="3" stroke-linecap="round" opacity=".85"/>
    {%- when 'dmg' -%}
      <path d="M3 12v152l4.5-3V15z"/><path d="M123 12v152l-4.5-3V15z"/>
      <path d="M124 58 102 72l16 7-14 10" stroke="#f4eee3" stroke-width="5" fill="none" stroke-linejoin="round"/>
      <path d="M8 38 118 152" stroke="#fff" stroke-width="3.6" stroke-linecap="round" opacity=".9"/>
      <ellipse cx="40" cy="132" rx="24" ry="16" fill="#c9b07a" opacity=".65"/>
  {%- endcase -%}
  </g>
</svg>
